---
# Template for the untracked local-vars file highstate.yml reads (see its
# vars_files entry). Copy this to ~/web/k0s-infra-vars.yml on the target host
# and fill in real values — that file is deliberately NOT part of this repo:
# directory layout and peer hostnames are personal/topology data with no
# business sitting in a public repo permanently, even though none of it is a
# secret in the credential sense (secrets still come from the host
# environment/secret store, never from this file either).
#
# Why ~/web specifically: it's already the established home for this kind of
# local, untracked config (see ~/.silvermirror -> ~/web/sync.ini), and since
# ~/web is itself synced+backed-up, this file propagates to every machine in
# the mesh automatically rather than needing separate provisioning per host.
#
# highstate.yml's restic role will fail fast with a clear "variable is
# undefined" error if this file is missing — that's intentional, not a bug.

restic_user: CHANGEME                # the account restic runs as
restic_sync_dirs:                    # every directory the sync mesh manages
  - "{{ ansible_env.HOME }}/web"
  - "{{ ansible_env.HOME }}/docs"
  - "{{ ansible_env.HOME }}/image"
  - "{{ ansible_env.HOME }}/movies"
  - "{{ ansible_env.HOME }}/music"
restic_offsite_host: CHANGEME        # hostname of the off-site backup peer
restic_offsite_path: "{{ ansible_env.HOME }}/restic/mesh"

k0sngin_service_user: CHANGEME       # the account k0sNgin's systemd service runs as
