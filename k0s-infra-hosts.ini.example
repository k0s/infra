# Template for the untracked internal-only inventory this repo reads on
# demand. Copy to ~/web/k0s-infra-hosts.ini and fill in real hostnames.
#
# Why this exists separately from inventory.ini: inventory.ini's k0s.org is
# already a public domain name, safe to track. Other real machines (an
# off-site backup peer, a home LAN box) are internal topology — the same
# class of personal data k0s-infra-vars.yml already externalizes, not
# something to bake into a public repo just because it's inventory syntax
# instead of a role variable.
#
# Usage: pass alongside inventory.ini, don't replace it —
#   ansible-playbook -i inventory.ini -i ~/web/k0s-infra-hosts.ini highstate.yml \
#     --limit <hostname> --tags syncthing --check --diff

CHANGEME

# roles/syncthing pairs and shares folders between every host in this group.
# Each member needs its device ID pinned (`syncthing --device-id` on that
# host) -- the pin is the trust decision. Run highstate.yml against the whole
# group so both sides of each pair converge in one run.
[syncthing_mesh]
localhost syncthing_pinned_device_id=CHANGEME syncthing_device_name=CHANGEME
CHANGEME  syncthing_pinned_device_id=CHANGEME

# roles/k0sngin_service and roles/links (the website) apply ONLY to hosts in
# this group. Outside it, a host gets no k0sNgin unit and no content symlinks.
[web_hosts]
localhost
CHANGEME

# roles/restic is applied ONLY to hosts in this group. Every other role in
# highstate.yml is appropriate to every machine, so a bare run is safe; backup
# is the exception, because a host that merely joins the sync mesh should not
# generate a repo password and start mirroring its copy off-site.
#
# Note this group must actually be loaded for restic to apply: pass this file
# alongside inventory.ini even for a local run, or the group is simply absent
# and the role silently skips.
[backup_hosts]
CHANGEME

# roles/cloudflared is applied ONLY to hosts in this group: the host that
# connects the site to its Cloudflare Tunnel. Its token goes in a root-only
# file on that host, never in this inventory (see roles/cloudflared).
[tunnel_hosts]
CHANGEME

# roles/navidrome is applied ONLY to hosts in this group: the machine at the
# TV with the speakers.
[media_hosts]
CHANGEME

# roles/navidrome_mcp is applied ONLY to hosts in this group: a media host
# whose desktop session plays through the speakers. Its secrets file must exist
# first (see roles/navidrome_mcp). To serve the LAN, set per host:
#   navidrome_mcp_expose=true navidrome_mcp_allowed_hosts=<name>:3000,localhost:3000
[navidrome_mcp_hosts]
CHANGEME
